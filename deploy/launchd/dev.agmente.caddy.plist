<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon template for Caddy, the public edge for the phone listener and the connector (D-098).
  Status: template, not installed. Replace every /Users/you path and the host name.

  It is a LaunchDaemon, not a user agent, because Caddy binds TCP 443, which needs root on macOS.
  Caddy then runs as root. Its certificate and state data go to XDG_DATA_HOME and XDG_CONFIG_HOME,
  so they stay under your own folder, not /var/root.

  Install:
    sudo mkdir -p /Users/you/agmente/caddy/data /Users/you/agmente/caddy/config
    sudo cp deploy/launchd/dev.agmente.caddy.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/dev.agmente.caddy.plist
    sudo chmod 644 /Library/LaunchDaemons/dev.agmente.caddy.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/dev.agmente.caddy.plist

  Stop and remove:
    sudo launchctl bootout system/dev.agmente.caddy

  Stop the manually started Caddy first, or 443 is already taken and this daemon fails to start.
  Changing the Caddyfile later: `caddy validate` it, then `caddy reload` (the admin API on localhost),
  which does not drop open connections.

  CONNECTOR_HOST is the public host name of the connector (docs/MAC-SETUP.md, section 13). The
  Caddyfile reads it as {$CONNECTOR_HOST}.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.agmente.caddy</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/caddy</string>
		<string>run</string>
		<string>--config</string>
		<string>/Users/you/agmente/caddy/Caddyfile</string>
		<string>--adapter</string>
		<string>caddyfile</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>CONNECTOR_HOST</key>
		<string>connector.your-domain.example</string>
		<key>XDG_DATA_HOME</key>
		<string>/Users/you/agmente/caddy/data</string>
		<key>XDG_CONFIG_HOME</key>
		<string>/Users/you/agmente/caddy/config</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>/Users/you/agmente/state/logs/caddy.out.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/you/agmente/state/logs/caddy.err.log</string>
</dict>
</plist>
