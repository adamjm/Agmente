# systemd unit for the gateway. Status: example; VERIFY on your host (PLAN task 1.11).
#
# Phase 1 runs the agent as a child of the gateway, as the same unprivileged user.
# Phases 3 and 4 move each project's agent and git into its own container (D-008).
#
# Setup:
#   useradd --system --home-dir /var/lib/acpcode --create-home acpcode
#   install -m 0644 -o root config.json /etc/acpcode/gateway.json      # hashes only, no secrets
#   install -m 0600 -o acpcode gateway.env /etc/acpcode/gateway.env     # BOB_API_KEY=...
#
# The agent sees only the variables listed in agent.envPassthrough.

[Unit]
Description=ACPCode gateway (authenticated ACP proxy)
After=network-online.target
Wants=network-online.target

[Service]
User=acpcode
Group=acpcode
WorkingDirectory=/opt/acpcode/gateway
# Build: go build -trimpath -o /opt/acpcode/gateway/bin/acpcode-gateway ./cmd/acpcode-gateway (D-021)
ExecStart=/opt/acpcode/gateway/bin/acpcode-gateway --config /etc/acpcode/gateway.json
EnvironmentFile=/etc/acpcode/gateway.env
Restart=on-failure
RestartSec=2

# Hardening. VERIFY each line against your systemd version.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/srv/acpcode/projects /var/lib/acpcode
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
